# LEEF GROUP : toutes les URL passent par le contrôleur frontal index.php (Apache).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forcer HTTPS en production (décommenter une fois le certificat SSL actif).
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Fichiers existants (build React, photos téléversées) servis tels quels
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Tout le reste (/, /admin/..., /api/...) : contrôleur frontal
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  # Scripts, styles et polices du build ont un nom unique (empreinte) : cache long.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images (logos, pictogrammes, photos téléversées) : une semaine, le temps qu'un logo remplacé se propage.
  <FilesMatch "\.(png|jpe?g|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Compression des textes (HTML, scripts, styles, JSON, plan du site) : environ 70 % de données en moins,
# donc un affichage plus rapide sur mobile (critère de classement Google : Core Web Vitals).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
